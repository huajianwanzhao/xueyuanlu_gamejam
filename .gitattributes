* text=auto eol=lf

# 文本：统一 LF，避免队友 Windows 上写 CRLF 造成整文件 diff
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.svg text eol=lf

# 二进制：绝不让 git 碰行尾（碰了贴图/音频就废了）
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.tga binary
*.exr binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.woff2 binary
*.pck binary
*.zip binary
*.exe binary
*.ctex binary
